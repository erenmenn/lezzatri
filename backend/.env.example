# =====================================================
# Lezzatri Backend – On-Premise Environment Variables
# =====================================================
# Salin file ini menjadi .env dan sesuaikan nilainya

# Server
PORT=3001

# Database MySQL Lokal (On-Premise)
# Jika pakai XAMPP: host=localhost, user=root, password=(kosong)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lezzatri_db
